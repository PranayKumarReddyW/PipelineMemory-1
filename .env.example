# PipelineMemory Environment Configuration
# Copy this file to backend/.env and fill in your values:
#   cp .env.example backend/.env

# Server port (default: 3001)
PORT=3001

# ─────────────────────────────────────────────────────────────────────────────
# 1. HINDSIGHT CONFIGURATION (Persistent Agent Semantic Memory)
# ─────────────────────────────────────────────────────────────────────────────
# Hindsight is the agent memory layer (retain, recall, reflect).
#
# Option A: Hindsight Cloud (Recommended — zero setup):
#   1. Sign up at https://ui.hindsight.vectorize.io/signup
#   2. Go to API Keys in the dashboard and create an API key
#   3. Paste below:
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# Option B: Self-Hosted Hindsight (via Docker):
#   docker run -it --pull always -p 8888:8888 -p 9999:9999 \
#     -e HINDSIGHT_API_LLM_API_KEY=your_key \
#     ghcr.io/vectorize-io/hindsight:latest
#   Then set:
# HINDSIGHT_BASE_URL=http://localhost:8888
# HINDSIGHT_API_KEY=

# Name of your Hindsight memory bank (default: pipeline-memory)
HINDSIGHT_BANK_ID=

# ─────────────────────────────────────────────────────────────────────────────
# 2. LLM CONFIGURATION — GROK (xAI) OR ANTHROPIC (Claude)
# ─────────────────────────────────────────────────────────────────────────────
# Used for natural-language risk explanations and Q&A synthesis.
# If no key is set, the system seamlessly uses rule-based fallbacks.
#
# Option A: Grok (xAI API)
#   Get your key at: https://console.x.ai/
GROK_API_KEY=
GROK_MODEL= # or grok-beta

# Option B: Anthropic Claude (alternative)
#   Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6-20250514

# ─────────────────────────────────────────────────────────────────────────────
# 3. STORAGE & LOGGING
# ─────────────────────────────────────────────────────────────────────────────
# Database path (default: ./data/pipeline_memory.db)
DB_PATH=./data/pipeline_memory.db

# Log level: debug | info | warn | error
LOG_LEVEL=info
